<?xml version="1.0" encoding="UTF-8"?>
<!-- For the projects that give the id "central" to another repository (MssqlJdbc: an Azure Artifacts feed that does not
     have plexus-compiler-eclipse): Maven Central again, which that feed only proxies. -->
<settings>
  <mirrors>
    <mirror>
      <id>maven-central</id>
      <mirrorOf>central</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
